# ==========================================
# Instagram Lead Generator - Configuration
# ==========================================

# Scraper Pacing & Anti-Detection
# Recommended: Keep CONCURRENCY=1 to prevent Instagram session bans
CONCURRENCY=1
TIMEOUT=30000
RETRIES=3

# Randomized delay range between requests (in seconds) to mimic human behavior
MIN_DELAY=8
MAX_DELAY=20

# Output & Export Settings
OUTPUT_FOLDER=OutputData
EXPORT_FORMAT=excel  # Options: excel, csv, json

# Optional: Proxy file for IP rotation (format: http://user:pass@host:port)
# PROXY_LIST_FILE=proxies.txt
